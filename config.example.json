{
  "_说明": "把本文件复制到 plugin/data/newGeYi/config.json 再改。带 api_key 的字段请勿提交到任何仓库。",

  "api_endpoint": "https://api.example.com/v1/chat/completions",
  "api_key": "",
  "api_protocol": "openai",
  "fast_model": "gemini-3.8-flash",
  "curate_model": "",
  "fast_temperature": 0.7,
  "fast_max_tokens": 8192,

  "providers": [
    {
      "name": "primary",
      "endpoint": "https://api.example.com/v1/chat/completions",
      "api_key": "",
      "model": "gemini-3.8-flash",
      "protocol": "openai",
      "priority": 1,
      "timeout": 60,
      "kinds": ["chat", "memory_curate"],
      "extra_body": { "reasoning_effort": "low" }
    },
    {
      "name": "local-proxy",
      "endpoint": "http://127.0.0.1:8787/v1",
      "api_key": "local-proxy",
      "model": "gemini-3.8-flash-low",
      "protocol": "anthropic",
      "priority": 2,
      "timeout": 45,
      "kinds": ["chat", "memory_curate"]
    },
    {
      "name": "backup",
      "endpoint": "https://api.example.com/v1/chat/completions",
      "api_key": "",
      "model": "deepseek-flash",
      "protocol": "openai",
      "priority": 3,
      "timeout": 60,
      "kinds": ["chat", "memory_curate"]
    },
    {
      "name": "opt-expensive",
      "endpoint": "https://api.example.com/v1/chat/completions",
      "api_key": "",
      "model": "glm-5.3-flash",
      "protocol": "openai",
      "priority": 4,
      "timeout": 60,
      "manual_only": true,
      "kinds": ["chat", "memory_curate"]
    }
  ],

  "failover": {
    "fail_threshold": 1,
    "probe_interval_seconds": 300,
    "probe_success_needed": 1,
    "probe_repair_per_round": 2,
    "probe_timeout_seconds": 10,
    "notify_owner": true,
    "notify_cooldown_seconds": 600,
    "switch_history_limit": 50
  },

  "triggers": ["歌伊"],
  "owner_ids": ["100000001"],
  "ignore_sender_ids": [],

  "private_enabled": false,
  "passive_enabled": true,
  "active_enabled": true,
  "active_shadow": true,
  "active_base_cooldown": 180,
  "active_daily_cap": 60,
  "active_quiet_hours": "01:00-07:00",

  "worldbook_enabled": true,
  "memory_enabled": true,
  "auto_memory_enabled": true,
  "memory_curator_enabled": true,
  "memory_curate_messages": 40,
  "memory_curate_idle_seconds": 900,
  "memory_curate_min_interval": 120,
  "memory_max_facts_per_user": 12,

  "time_awareness_enabled": true,

  "image_enabled": true,
  "image_max_per_turn": 3,
  "image_max_bytes": 4194304,
  "image_total_max_bytes": 1572864,
  "image_download_timeout": 10,

  "emote_enabled": true,
  "emote_min_gap_seconds": 180,
  "emote_window_replies": 5,
  "emote_hourly_cap": 6,

  "voice_enabled": false,
  "voice_gateway_url": "http://127.0.0.1:9885/v1/voice/synthesize",
  "voice_health_url": "http://127.0.0.1:9885/health",
  "voice_auth_token": "",
  "voice_timeout": 10.0,
  "voice_group_cooldown": 45,
  "voice_poke_rate": 0.25,
  "voice_speed": 1.0,

  "rest_enabled": true,
  "rest_minutes": 10,

  "reply_audit_enabled": true,
  "reply_audit_fallback": "",

  "max_recent_turns": 20,
  "max_context_chars": 32000,
  "group_live_window_seconds": 1800,
  "group_live_max_messages": 60,
  "group_live_max_chars": 16000,
  "max_reply_chars": 1200,

  "request_timeout_seconds": 25,
  "max_retries": 1,
  "global_concurrency": 4,
  "daily_call_budget": 500,
  "daily_output_token_budget": 100000
}
